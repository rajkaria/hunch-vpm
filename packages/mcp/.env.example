# @hunch-vpm/mcp configuration. Copy to .env and edit, or set these in your MCP host's
# server config. One variable is required; the rest default to Arc testnet.

# REQUIRED. The hunch-vpm subgraph: every tool reads the venue through it, and
# @hunch-vpm/client refuses to be constructed without an endpoint, so the server does not
# start without this. Set it, or set HUNCH_VPM_SUBGRAPH_ID with an API key instead.
HUNCH_VPM_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/hunch-vpm/<version>

# Subgraph Studio id, expanded into https://gateway.thegraph.com/api/<key>/subgraphs/id/<id>.
# An alternative to the URL above, not an addition.
# HUNCH_VPM_SUBGRAPH_ID=

# The ERC-8004 subgraph on Arc: identity and reputation. Optional — without it
# vpm_agent_reputation still reports the AgentBook flag and venue activity, and says which
# half is missing.
# HUNCH_VPM_ERC8004_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/erc8004-arc/<version>
# HUNCH_VPM_ERC8004_SUBGRAPH_ID=

# The Graph gateway key. It becomes a path segment of the gateway URL: keep it out of logs.
# HUNCH_VPM_GRAPH_API_KEY=

# 5042002 = Arc testnet, 5042 = Arc mainnet.
HUNCH_VPM_CHAIN_ID=5042002

# Overrides the chain preset. Required on a chain this server has no preset for.
# HUNCH_VPM_RPC_URL=https://rpc.testnet.arc.network
# HUNCH_VPM_EXPLORER_URL=https://testnet.arcscan.app

# VestedParimutuel. The zero address is a placeholder — no contracts are deployed yet.
HUNCH_VPM_SETTLER_ADDRESS=0x0000000000000000000000000000000000000000

# ClassicParimutuel, once the side-by-side comparison is deployed.
# HUNCH_VPM_CLASSIC_SETTLER_ADDRESS=0x0000000000000000000000000000000000000000

# Per-request timeout for this server's own subgraph reads, in milliseconds (500-120000).
# HUNCH_VPM_REQUEST_TIMEOUT_MS=10000

# Cap on per-position vesting reads in one vpm_claimable call (0-200).
# HUNCH_VPM_MAX_POSITION_LOOKUPS=25
